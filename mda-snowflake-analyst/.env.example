# Copy to .env (gitignored). `mda deploy` forwards non-reserved values as deployment secrets.

# LangSmith personal access token (lsv2_pt_...). `mda dev` needs a personal key so
# per-user OAuth (your Snowflake sign-in) resolves to you.
LANGSMITH_API_KEY=

# Model key. To route through the LangSmith LLM Gateway, use a LangSmith key here
# and keep ANTHROPIC_BASE_URL; to call Anthropic directly, use an Anthropic key and
# delete ANTHROPIC_BASE_URL.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://gateway.smith.langchain.com/anthropic

# LangSmith Tools URL of the registered Snowflake MCP server
# (printed by scripts/create_snowflake_connection.sh).
SNOWFLAKE_MCP_URL=https://api.smith.langchain.com/v1/managed-tools/servers/<server-id>/mcp
