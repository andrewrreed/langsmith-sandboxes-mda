# Copy to .env (gitignored) and fill in.
LANGSMITH_API_KEY=            # PAT in the workspace that has the Tools beta + Sandboxes
LANGSMITH_WORKSPACE_ID=       # workspace (tenant) id
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
ANTHROPIC_API_KEY=            # or OPENAI_API_KEY; model for the agent

# If ANTHROPIC_API_KEY is a LangSmith key, route through the LLM Gateway:
ANTHROPIC_BASE_URL=https://gateway.smith.langchain.com/anthropic
